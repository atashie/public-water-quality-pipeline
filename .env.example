# Copy this file to .env at the repository root. Git ignores .env and the coding agent may not read it.
# Never paste a credential into a document, a script, or a chat.

# NASA Earthdata Login. Needed to download CyAN files from the OB.DAAC and for Earthdata Cloud S3.
# Generate a token at https://urs.earthdata.nasa.gov/ under "Generate Token". Tokens expire.
OB_DAAC_EDL_TOKEN=
# Optional alternative for OB.DAAC getfile downloads: https://oceandata.sci.gsfc.nasa.gov/appkey/
OB_DAAC_APPKEY=

# Copernicus Data Space Ecosystem. S3 keys come from the S3 keys manager on dataspace.copernicus.eu.
# The account login obtains the OData download token.
CDSE_S3_ACCESS_KEY=
CDSE_S3_SECRET_KEY=
CDSE_USERNAME=
CDSE_PASSWORD=
